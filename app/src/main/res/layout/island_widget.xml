<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="12dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="ScrollXP" android:textSize="16sp" android:textStyle="bold" android:textColor="#E3E8DB"
        android:maxLines="1" android:ellipsize="end" />
    <ImageView android:id="@+id/widget_art" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="@string/widget_description"
        android:src="@drawable/ic_launcher_foreground" />
    <TextView android:id="@+id/widget_progress" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Your island is waiting" android:textColor="#AFBBAD" android:textSize="12sp" />
    <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#AFBBAD" android:textSize="12sp" android:visibility="gone" />
</LinearLayout>
